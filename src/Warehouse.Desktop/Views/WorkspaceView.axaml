<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Warehouse.Desktop.ViewModels"
             xmlns:views="using:Warehouse.Desktop.Views"
             x:Class="Warehouse.Desktop.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">
  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DCE3EC" BorderThickness="0,0,0,1"
            Padding="24,15">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="20">
        <StackPanel Spacing="2">
          <TextBlock Text="Складской учёт" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StorageMode}" Foreground="#4B5D74" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding Identity}" VerticalAlignment="Center" />
        <Button Grid.Column="2" Content="Выйти" Command="{Binding SignOut}" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <TextBlock DockPanel.Dock="Top" Text="{Binding StorageNotice}" Margin="24,12"
               Foreground="#4B5D74" TextWrapping="Wrap" />
    <TabControl Margin="24,0,24,18">
      <TabItem Header="Справочник">
        <views:CatalogView DataContext="{Binding Catalog}" Margin="0,8,0,0" />
      </TabItem>
      <TabItem Header="Документы">
        <views:DocumentsView DataContext="{Binding Documents}" Margin="0,8,0,0" />
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
