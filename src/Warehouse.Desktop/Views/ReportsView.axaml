<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Warehouse.Desktop.ViewModels" x:Class="Warehouse.Desktop.Views.ReportsView"
             x:DataType="vm:ReportsViewModel">
  <Grid RowDefinitions="*,Auto,Auto" RowSpacing="6">
    <Border Classes="panel">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <WrapPanel ItemSpacing="8" LineSpacing="8" IsEnabled="{Binding !Busy}">
          <ComboBox Width="225" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedReport}"
                    AutomationProperties.Name="Вид отчёта">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:ReportChoice"><TextBlock Text="{Binding Name}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Width="185" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}"
                    IsVisible="{Binding HasWarehouse}" AutomationProperties.Name="Склад отчёта">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:ReportWarehouse"><TextBlock Text="{Binding Name}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Width="300" ItemsSource="{Binding AvailableInventories}" SelectedItem="{Binding SelectedInventory}"
                    IsVisible="{Binding HasReconciliation}" AutomationProperties.Name="Ревизия для отчёта">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:ReportInventory"><TextBlock Text="{Binding Name}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Width="265" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}"
                    IsVisible="{Binding HasDocument}" AutomationProperties.Name="Документ для формы">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:ReportDocument"><TextBlock Text="{Binding Name}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasPeriod}">
            <TextBlock Text="С" VerticalAlignment="Center" />
            <DatePicker SelectedDate="{Binding From}" AutomationProperties.Name="Начало периода" />
            <TextBlock Text="по" VerticalAlignment="Center" />
            <DatePicker SelectedDate="{Binding Until}" AutomationProperties.Name="Конец периода" />
          </StackPanel>
          <Button Content="Сформировать" Classes="accent" Click="OnGenerate" />
        </WrapPanel>
        <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding Busy}" />
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Details}" />
        <DataGrid x:Name="Preview" Grid.Row="3" IsReadOnly="True" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto"
                  IsVisible="{Binding HasTable}" AutomationProperties.Name="Данные отчёта" />
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{Binding RowCount}" Classes="muted" />
            <TextBlock Text="{Binding Totals}" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !Busy}"
                      IsVisible="{Binding HasTable}">
            <Button Content="Сохранить Excel" Click="OnExcel" IsVisible="{Binding HasExcel}" />
            <Button Content="Сохранить PDF" Click="OnPdf" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
    <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="#176544" AutomationProperties.LiveSetting="Polite" />
    <TextBlock Grid.Row="2" Text="{Binding Error}" Classes="error" AutomationProperties.LiveSetting="Polite" />
  </Grid>
</UserControl>
