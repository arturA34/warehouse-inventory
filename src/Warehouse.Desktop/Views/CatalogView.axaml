<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Warehouse.Desktop.ViewModels"
             xmlns:domain="using:Warehouse.Domain"
             xmlns:app="using:Warehouse.Application"
             x:Class="Warehouse.Desktop.Views.CatalogView"
             x:DataType="vm:CatalogViewModel">
  <UserControl.Styles>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#DCE3EC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="TextBlock.column">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#4B5D74" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="6,9" />
    </Style>
    <Style Selector="TextBlock.cell">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <TabControl>
      <TabItem Header="Каталог">
        <Grid ColumnDefinitions="*,300" ColumnSpacing="14" Margin="0,12,0,0">
          <Border Classes="panel">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding Query}" Watermark="Артикул, название или штрихкод"
                         AutomationProperties.Name="Поиск по каталогу" />
                <Button Grid.Column="1" Content="Найти" IsDefault="True" Command="{Binding Search}" />
                <Button Grid.Column="2" Content="Новый товар" Classes="accent" Command="{Binding NewProduct}"
                        IsVisible="{Binding CanManageCatalog}" />
              </Grid>
              <CheckBox Grid.Row="1" Content="Показывать архивные товары" IsChecked="{Binding IncludeArchived}" />
              <Grid Grid.Row="2" ColumnDefinitions="*,*,2*,*,*" ColumnSpacing="8" Margin="6,0">
                <TextBlock Classes="column" Text="Артикул" />
                <TextBlock Grid.Column="1" Classes="column" Text="Штрихкод" />
                <TextBlock Grid.Column="2" Classes="column" Text="Название" />
                <TextBlock Grid.Column="3" Classes="column" Text="Ед." />
                <TextBlock Grid.Column="4" Classes="column" Text="Статус" />
              </Grid>
              <ListBox Grid.Row="3" Classes="rows" Background="Transparent" ItemsSource="{Binding Products}"
                       SelectedItem="{Binding SelectedProduct}" AutomationProperties.Name="Товары">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="domain:Product">
                    <Grid ColumnDefinitions="*,*,2*,*,*" ColumnSpacing="8">
                      <TextBlock Classes="cell" Text="{Binding Sku}" />
                      <TextBlock Grid.Column="1" Classes="cell" Text="{Binding Barcode}" />
                      <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Name}" />
                      <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Unit}" />
                      <TextBlock Grid.Column="4" Classes="cell" Text="В архиве" Foreground="#4B5D74"
                                 IsVisible="{Binding !IsActive}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button Content="Назад" Command="{Binding PreviousPage}" IsEnabled="{Binding HasPreviousPage}" />
                <TextBlock Grid.Column="1" Text="{Binding PageLabel}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Вперёд" Command="{Binding NextPage}" IsEnabled="{Binding HasNextPage}" />
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Column="1" Classes="panel" IsVisible="{Binding HasEditor}">
            <ScrollViewer>
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding EditorTitle}" FontSize="19" FontWeight="SemiBold" />
                <StackPanel Spacing="3">
                  <TextBlock Text="Название" />
                  <TextBox Text="{Binding Draft.Name}" IsReadOnly="{Binding !CanManageCatalog}"
                           AutomationProperties.Name="Название товара" />
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Артикул" />
                    <TextBox Text="{Binding Draft.Sku}" IsReadOnly="{Binding !CanManageCatalog}"
                             AutomationProperties.Name="Артикул товара" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="Штрихкод" />
                    <TextBox Text="{Binding Draft.Barcode}" IsReadOnly="{Binding !CanManageCatalog}"
                             AutomationProperties.Name="Штрихкод товара" />
                  </StackPanel>
                </Grid>
                <StackPanel Spacing="3">
                  <TextBlock Text="Единица измерения" />
                  <TextBox Text="{Binding Draft.Unit}" IsReadOnly="{Binding !CanManageCatalog}"
                           AutomationProperties.Name="Единица измерения" />
                </StackPanel>
                <Button Content="Сохранить товар" Classes="accent" Command="{Binding SaveProduct}"
                        IsVisible="{Binding CanManageCatalog}" />

                <StackPanel Spacing="8" Margin="0,8,0,0" IsVisible="{Binding CanSetMinimum}">
                  <Separator />
                  <TextBlock Text="Минимальный остаток" FontSize="17" FontWeight="SemiBold" />
                  <ComboBox PlaceholderText="Склад" ItemsSource="{Binding Warehouses}"
                            SelectedItem="{Binding SelectedWarehouse}" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Склад для минимального остатка">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="domain:WarehouseSite">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <NumericUpDown Value="{Binding Minimum}" Minimum="0" Maximum="79228162514264337593543950335"
                                 Watermark="Количество" ShowButtonSpinner="False"
                                 AutomationProperties.Name="Минимальное количество" />
                  <Button Content="Сохранить минимум" Command="{Binding SaveMinimum}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Остатки">
        <Border Classes="panel" Margin="0,12,0,0">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <CheckBox Content="Только ниже минимума" IsChecked="{Binding ShowWarningsOnly}" />
              <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshBalances}" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,*,2*,*,*,*" ColumnSpacing="12" Margin="6,0">
              <TextBlock Classes="column" Text="Склад" />
              <TextBlock Grid.Column="1" Classes="column" Text="Артикул" />
              <TextBlock Grid.Column="2" Classes="column" Text="Товар" />
              <TextBlock Grid.Column="3" Classes="column" Text="Остаток" />
              <TextBlock Grid.Column="4" Classes="column" Text="Минимум" />
              <TextBlock Grid.Column="5" Classes="column" Text="Предупреждение" />
            </Grid>
            <ListBox Grid.Row="2" Classes="rows" Background="Transparent" ItemsSource="{Binding VisibleBalances}"
                     AutomationProperties.Name="Остатки товаров">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="app:BalanceRow">
                  <Grid ColumnDefinitions="*,*,2*,*,*,*" ColumnSpacing="12">
                    <TextBlock Classes="cell" Text="{Binding WarehouseName}" />
                    <TextBlock Grid.Column="1" Classes="cell" Text="{Binding Sku}" />
                    <TextBlock Grid.Column="2" Classes="cell" Text="{Binding ProductName}" />
                    <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Quantity}" />
                    <TextBlock Grid.Column="4" Classes="cell" Text="{Binding Minimum}" />
                    <TextBlock Grid.Column="5" Classes="cell" Text="Ниже минимума" Foreground="#A32C35"
                               FontWeight="SemiBold" IsVisible="{Binding BelowMinimum}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="1" Margin="0,8,0,0" MinHeight="20">
      <TextBlock Text="{Binding Status}" Foreground="#176544" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="{Binding Error}" Classes="error" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </Grid>
</UserControl>
