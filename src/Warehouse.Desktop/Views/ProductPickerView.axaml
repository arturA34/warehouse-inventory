<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Warehouse.Desktop.ViewModels" xmlns:domain="using:Warehouse.Domain"
             x:Class="Warehouse.Desktop.Views.ProductPickerView" x:DataType="vm:ProductPickerViewModel">
  <StackPanel Spacing="5">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
      <TextBox Text="{Binding Query}" Watermark="Артикул, название или штрихкод" AutomationProperties.Name="Поиск товара" />
      <Button Grid.Column="1" Content="Найти" Command="{Binding Search}" />
    </Grid>
    <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch"
              PlaceholderText="Выберите товар" AutomationProperties.Name="Выбор товара">
      <ComboBox.ItemTemplate>
        <DataTemplate DataType="domain:Product">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Sku}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Name}" />
          </StackPanel>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="‹" Command="{Binding Previous}" IsEnabled="{Binding CanGoBack}" AutomationProperties.Name="Предыдущая страница" />
      <TextBlock Text="{Binding Range}" VerticalAlignment="Center" />
      <Button Content="›" Command="{Binding Next}" IsEnabled="{Binding CanGoForward}" AutomationProperties.Name="Следующая страница" />
    </StackPanel>
    <TextBlock Classes="error" Text="{Binding Error}" />
  </StackPanel>
</UserControl>
